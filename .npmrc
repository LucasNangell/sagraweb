# Store do pnpm em disco local (evita parte dos problemas em rede)
store-dir=C:\pnpm-store

# PowerShell com Bypass: evita bloqueio de ExecutionPolicy (pnpm.ps1) apos formatacao.
# Caminho local C:\dev\... — em UNC use deploy\bat\dev-spa-local.bat.
script-shell=powershell.exe -NoProfile -ExecutionPolicy Bypass -Command
