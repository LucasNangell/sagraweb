# Store do pnpm em disco local (evita parte dos problemas em rede)
store-dir=C:\pnpm-store

# Windows 11 25H2 (build 26200) recusa junctions do pnpm isolado
# ("ponto de montagem nao confiavel" / Node UNKNOWN ao abrir package.json).
# Layout hoisted usa pastas reais (estilo npm) e deixa Vite/React resolvem.
# Pacotes workspace (@sagra/ui, @sagra/api-types) sao copiados no postinstall
# (scripts/materialize-workspace-packages.mjs) — o pnpm ainda cria junction.
# Trocar o linker exige apagar todos os node_modules e rodar pnpm install.
node-linker=hoisted

# Apenas o executavel — NAO colocar argumentos aqui (gera ENOENT/-4058 no pnpm).
# ExecutionPolicy: bats/scripts usam -ExecutionPolicy Bypass; Vite sobe via node no _iniciar-web.cmd.
# Em UNC use deploy\bat\dev-spa-local.bat.
script-shell=powershell.exe
