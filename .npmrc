# Store do pnpm em disco local (evita parte dos problemas em rede)
store-dir=C:\pnpm-store

# Scripts via cmd.exe — caminho local C:\dev\... (padrao apos formatacao).
# powershell.exe + ExecutionPolicy Restricted bloqueia %APPDATA%\npm\pnpm.ps1.
# Em UNC (\\servidor\...), use deploy\bat\dev-spa-local.bat (espelha em C:\dev\SagraWeb).
script-shell=C:\Windows\System32\cmd.exe
