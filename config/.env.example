# Copie para config/.env e ajuste conforme o ambiente.
# Com ENV=development (iniciar-servidor.bat), host/MDB vêm de config/config.development.json
# (MySQL 127.0.0.1 + MDB em c:\_sagra\). Em produção (VM) use o .env da VM + config.json.
#
# DEV (XAMPP/MariaDB local, root sem senha):
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=sagrafulldb
# Produção (referência — NÃO use estes valores no PC de DEV):
# DB_HOST=10.1.1.73
# DB_USER=usr_sagraweb
# DB_PASSWORD=CHANGE_ME
# MASTER_IP no .env só é usado se config.json não definir allowed_ips.master
# SAGRA_DEV_CLIENT_IP / VITE_DEV_CLIENT_IP: só para acesso local (localhost:5173 no servidor dev).
# Outras máquinas na LAN usam o IP real automaticamente — não force o IP do master.
# Links públicos (e-mail de ativação, portal): raiz do domínio (sem /sagra/)
# SAGRA_PUBLIC_WEB_BASE=http://cgrafsysvm
# Dev local: SAGRA_PUBLIC_WEB_BASE=http://127.0.0.1:5173
# Testes via domínio público HTTPS (mesmas regras que cgraf.online):
# SAGRA_PUBLIC_WEB_BASE=https://cgrafsysvm.redecamara.camara.gov.br
# SAGRA_CORS_ORIGINS=http://10.1.1.73,http://cgrafsysvm,https://cgrafsysvm.redecamara.camara.gov.br
# Em produção: config.json public_web_base (ex.: https://cgrafsysvm.redecamara.camara.gov.br); API do SPA segue em /sagra/api.
# Painéis /sagra/painel/*: sem login; API de leitura sem IP cadastrado (padrão true)
# SAGRA_PAINEL_SKIP_IP_CHECK=false
#
# zrok no PC local (túnel para http://cgrafsysvm/sagra/) — ver iniciar-zrok-painel.bat
# No servidor cgrafsysvm (produção), se cookies falharem via HTTPS do zrok:
# SAGRA_SESSION_SECURE=true
MASTER_IP=127.0.0.1
# VITE_DEV_CLIENT_IP=10.120.1.14
# SAGRA_DEV_CLIENT_IP=10.120.1.14
PORT=8001
ENV=development
# Uma porta (iniciar-servidor.bat): controle de paginas no FastAPI
# SAGRA_SPA_ACCESS_CONTROL=true
# false = dual-write MySQL + MDB (OS Atual / Papelaria Atual)
MYSQL_ONLY=false
SYNC_ANDAMENTOS_ENABLED=false
# Home /os/search: preferir tabela materializada (evita ROW_NUMBER live). Só produção.
# OS_SEARCH_PREFER_MATERIALIZED=1
# true = replica MDB em background após MySQL (não bloqueia a tela)
MDB_SYNC_ASYNC_ENABLED=true
MDB_RETRY_MAX_ATTEMPTS=5
MDB_RETRY_BASE_WAIT_SECONDS=2

# Portal cliente — upload direto ao Google Drive (evita consumo de banda do túnel zrok)
# Requer config/gdrive/client_secret*.json + token.json (OAuth conta fotolitocd@gmail.com)
# Pasta de staging no Drive (padrão: Originais)
# SAGRA_PORTAL_UPLOAD_GDRIVE=true
# SAGRA_GDRIVE_CREDENTIALS_DIR=config/gdrive
# SAGRA_GDRIVE_STAGING_FOLDER=Originais

# E-mail / Exchange (EWS) — Outlook NÃO é necessário; API SOAP em ce.camara.leg.br
# Use aspas se a senha contiver $ ou espaços: EWS_PASSWORD="sua_senha"
# EWS_USERNAME=redecamara\P_918713
# EWS_PASSWORD=
# EWS_HTTPS_PROXY=   # opcional; vazio = ignora HTTP_PROXY do Windows (recomendado no servidor)

# --- Segurança (Fase 1) ---
# Obrigatório em produção (ENV=production): mínimo 32 caracteres aleatórios
# SAGRA_SESSION_SECRET=CHANGE_ME_USE_openssl_rand_hex_32
# Cookie Secure em HTTPS/zrok: SAGRA_SESSION_SECURE=true
#
# Notificações WebSocket (sync/monitor): preferencial em produção
# Scripts locais enviam header X-Sagra-Notify-Secret com este valor.
# Se ausente, IP privilegiado (servidor/MASTER) continua autorizado (legado).
# SAGRA_NOTIFY_SECRET=CHANGE_ME_USE_openssl_rand_hex_32
#
# Worker Papelaria CorelDRAW (máquina Windows separada):
# Header X-Sagra-Worker-Secret — mesmo valor em worker/papelaria_worker/config.yaml
# SAGRA_PAPELARIA_WORKER_SECRET=CHANGE_ME_USE_openssl_rand_hex_32
#
# Rate limit em rotas de auth (padrão true): SAGRA_RATE_LIMIT_ENABLED=true

# --- Web Push (notificações com navegador/app fechado) ---
# Produção: gere com python app/backend/scripts/generate_vapid_keys.py
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:sagra-web@redecamara.camara.gov.br
# VAPID_SUBJECT_CAMARA_LEG_BR=mailto:sagra-web@cgrafsysvm.camara.leg.br
# DEV (ENV=development): chaves criadas automaticamente em config/vapid_dev.json
# DEV: VITE_PWA_DEV=true  (habilita service worker no Vite para testar push localmente)
VITE_PWA_DEV=true

# --- Estabilidade (Fase 2) ---
# Pool MySQL: SAGRA_DB_POOL_SIZE=10  SAGRA_DB_CONNECT_TIMEOUT=10  SAGRA_DB_READ_TIMEOUT=60
# Pré-análise: SAGRA_PREANALISE_MAX_JOBS=2  SAGRA_PREANALISE_MAX_PDF_FILES=30
#              SAGRA_PREANALISE_MAX_PDF_MB=200  SAGRA_PREANALISE_MAX_PAGES=600
# EWS timeout (segundos): EWS_TIMEOUT=30

# --- Performance (Fase 3) ---
# Cache curto da fila PCP (segundos; 0 = desligado): SAGRA_PCP_QUEUE_CACHE_SEC=8
# PNG do mockup 3D Papelaria (escala PyMuPDF; padrão 4, máx. 6): SAGRA_PAPELARIA_PREVIEW_SCALE=4
# Busca OS: limite máximo 100/página; LIKE em texto exige >=3 chars sem nr_os/ano
# Home /os/search: preferir tabela materializada (evita ROW_NUMBER live em tabAndamento).
# Em produção (VM): OS_SEARCH_PREFER_MATERIALIZED=1 — ver deploy/scripts/enable-os-search-materialized.ps1
# OS_SEARCH_PREFER_MATERIALIZED=0
