      "html": "<table border=\"0\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n    <tbody>\n    <tr>\n    <td style=\"padding: 0px 0 0 0;\" align=\"left\"><!-- Main Container Table (Rigid 700px width) -->\n    <table style=\"width: 850px; border-collapse: collapse; background-color: #ffffff; border: 1px solid #dddddd; font-family: Calibri, Candara, Segoe, 'Segoe UI', Optima, Arial, sans-serif;\" border=\"0\" width=\"850\" cellspacing=\"0\" cellpadding=\"0\" align=\"left\"><!-- Header Banner -->\n    <tbody>\n    <tr>\n    <td align=\"center\"><img style=\"display: block; width: 850px; border: 0px; max-width: 100%;\" src=\"https://cgrafsysvm.camara.leg.br/email_images/header_apogee.png\" alt=\"\" width=\"850\" draggable=\"false\"></td>\n    </tr>\n    <!-- Main Content Area -->\n    <tr>\n    <td style=\"padding: 0px 0px 0px 25px;\"><!-- Job Info Section -->\n    <table style=\"margin-bottom: 0px;\" border=\"0\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n    <tbody>\n    <tr>\n    <td style=\"padding-right: 10px; padding-top: 25px;\" valign=\"middle\" width=\"120\"><img style=\"display: block; border: 0px; max-width: 100%;\" src=\"https://cgrafsysvm.camara.leg.br/email_images/gravacao_concluida.png\" alt=\"Info\" width=\"120\" draggable=\"false\"></td>\n    <td style=\"padding-top: 25px; color: #00a859; font-size: 18.67px; line-height: 1.4; font-family: Calibri, sans-serif;\" valign=\"middle\">\n    <p><strong>Ordem de Serviço [{{nr_os}}/{{ano}}]</strong></p>\n    <p><strong>está disponível para retirada das chapas no Birô</strong></p>\n    </td>\n    </tr>\n    </tbody>\n    </table>\n    <!-- Instructions Section -->\n    <table style=\"margin-bottom: 25px; width: 100%;\" cellspacing=\"0\" cellpadding=\"0\">\n    <tbody>\n    <tr>\n    <td style=\"padding-right: 0px; width: 15.2933%; text-align: right; margin-right: 5px;\">&nbsp;</td>\n    <td style=\"width: 84.7202%;\">\n    <p style=\"margin: 0 0 20px 0; font-size: 16px; line-height: 1.5; color: #333333; font-family: Calibri, sans-serif;\">Birô de gravação externa informou, via Sagra WEB, que as chapas foram gravadas e estão prontas para retirada pela CGraf ou para entrega pelo Birô.</p>\n    \n    <p style=\"margin: 0 0 20px 0; font-size: 16px; line-height: 1.5; color: #333333; font-family: Calibri, sans-serif;\"><!-- Bulletproof Button --></p>\n    <table border=\"0\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n    <tbody>\n    <tr>\n    <td style=\"padding: 10px 0 20px 0;\" align=\"left\">\n    <table border=\"0\" cellspacing=\"0\" cellpadding=\"0\" align=\"left\">\n    <tbody>\n    <tr>\n    <td align=\"left\"><a style=\"text-decoration: none; display: block;\" href=\"https://cgrafsysvm.camara.leg.br\" target=\"_blank\" rel=\"noopener\"> <img style=\"display: block; margin: 0px; width: 260px; height: auto; max-width: 100%;\" src=\"https://cgrafsysvm.camara.leg.br/email_images/acessar_sagra.png\" alt=\"Acessar Sagra Web\" width=\"260\" border=\"0\" draggable=\"false\"> </a></td>\n    </tr>\n    </tbody>\n    </table>\n    </td>\n    </tr>\n    </tbody>\n    </table>\n    </td>\n    </tr>\n    </tbody>\n    </table>\n    </td>\n    </tr>\n    <tr>\n    <td align=\"center\"><img style=\"display: block; width: 850px; border: 0px; max-width: 100%;\" src=\"https://cgrafsysvm.camara.leg.br/email_images/footer.png\" alt=\"\" width=\"850\" draggable=\"false\"></td>\n    </tr>\n    </tbody>\n    </table>\n    </td>\n    </tr>\n    </tbody>\n    </table>",
