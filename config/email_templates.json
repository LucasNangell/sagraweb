Web permite fazer todas as tramitações nas ordens de serviço e acompanhar o status de cada uma delas.</p>\n    <!-- Bulletproof Button -->\n    <table border=\"0\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">\n    <tbody>\n    <tr>\n    <td style=\"padding: 10px 0 20px 0;\" align=\"left\">\n    <table border=\"0\" cellspacing=\"0\" cellpadding=\"0\" align=\"left\">\n    <tbody>\n    <tr>\n    <td align=\"left\"><a style=\"text-decoration: none; display: block;\" href=\"{{link}}\" target=\"_blank\" rel=\"noopener\"> \n        <img style=\"display: block; margin: 0; width: 250px; height: auto;\" src=\"https://cgrafsysvm.camara.leg.br/email_images/btn_create_password.png\" alt=\"Ativar conta\" width=\"250\" border=\"0\"> </a></td>\n    </tr>\n    </tbody>\n    </table>\n    </td>\n    </tr>\n    </tbody>\n    </table>\n    </td>\n    </tr>\n    </tbody>\n    </table>\n    </td>\n    </tr>\n    <tr>\n    <td align=\"center\"><img style=\"display: block; width: 850px; border: 0;\" src=\"https://cgrafsysvm.camara.leg.br/email_images/footer.png\" alt=\"\" width=\"850\"></td>\n    </tr>\n    </tbody>\n    </table>\n    </td>\n    </tr>\n    </tbody>\n    </table>",
