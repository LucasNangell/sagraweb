# Copie para config/.env no servidor 10.1.1.73

DB_HOST=10.1.1.73
DB_USER=usr_sagraweb
DB_PASSWORD=CHANGE_ME
DB_NAME=sagrafulldb
MASTER_IP=10.120.1.14
PORT=8010
ENV=production

# OCR — Raster parcial (requer Tesseract instalado no Windows)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

MYSQL_ONLY=true
SYNC_ANDAMENTOS_ENABLED=false
MDB_RETRY_MAX_ATTEMPTS=5
MDB_RETRY_BASE_WAIT_SECONDS=2

SAGRA_CORS_ORIGINS=http://10.1.1.73,http://cgrafsysvm,https://cgrafsysvm.redecamara.camara.gov.br,https://cgrafsysvm.camara.leg.br,https://cgraf.online,https://www.cgraf.online,https://white-sun-19a3.fotolitocd.workers.dev

# Links em e-mail (ativação de usuário) — domínio público, não IP interno
SAGRA_PUBLIC_WEB_BASE=https://cgrafsysvm.redecamara.camara.gov.br

# E-mail / Exchange (EWS) — conta técnica; Outlook NÃO é necessário no servidor
# EWS_USERNAME=redecamara\usuario_servico
# EWS_PASSWORD="senha"
# Opcional: proxy só para EWS (vazio = conexão direta, ignora proxy do Windows)
# EWS_HTTPS_PROXY=http://proxy-interno:3128

# Portal cliente — upload via Google Drive (staging Originais; credenciais em config/gdrive/)
# SAGRA_PORTAL_UPLOAD_GDRIVE=true
# SAGRA_GDRIVE_CREDENTIALS_DIR=config/gdrive
# SAGRA_GDRIVE_STAGING_FOLDER=Originais

# Web Push — chaves em shared/config/vapid.json (gerar: python app/backend/scripts/generate_vapid_keys.py)
VAPID_SUBJECT=mailto:sagra-web@redecamara.camara.gov.br
VAPID_SUBJECT_CAMARA_LEG_BR=mailto:sagra-web@cgrafsysvm.camara.leg.br

# --- Gravação Externa — cache de ZIP (montagem em background) ---
# Execute deploy/scripts/mover-cache-zip-gravacao-externa.ps1 no servidor antes de ativar.
SAGRA_GE_ZIP_DIR=F:\SagraWeb\gravacao_externa_zips
SAGRA_GE_ZIP_CACHE_MAX_GB=200
SAGRA_GE_ZIP_MIN_FREE_GB=10
# SAGRA_GE_ZIP_TTL_HORAS=24
# SAGRA_GE_ZIP_WORKERS=1
