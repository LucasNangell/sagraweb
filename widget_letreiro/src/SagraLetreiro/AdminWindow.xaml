<Window x:Class="SagraLetreiro.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Administração do letreiro"
        Width="920"
        Height="560"
        MinWidth="720"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#0f0f12"
        Foreground="#e8e8ee"
        FontFamily="Segoe UI"
        Topmost="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Background" Value="#2a2a32" />
            <Setter Property="Foreground" Value="#e8e8ee" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1c1c21" />
            <Setter Property="Foreground" Value="#e8e8ee" />
            <Setter Property="BorderBrush" Value="#2e2e36" />
            <Setter Property="RowBackground" Value="#1c1c21" />
            <Setter Property="AlternatingRowBackground" Value="#16161a" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#121214" />
            <Setter Property="Foreground" Value="#9b9ba8" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#2e2e36" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="16" Background="#16161a">
            <DockPanel>
                <TextBlock x:Name="StatusText" Foreground="#9b9ba8" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Atualizar" Click="OnRefresh" />
                    <Button Content="Editar configuração" Click="OnEdit" />
                    <Button Content="Aplicar a todos" Click="OnApplyAll" Background="#8257e6" Foreground="White" />
                </StackPanel>
            </DockPanel>
        </Border>
        <DockPanel Margin="16">
            <TextBlock DockPanel.Dock="Top" Text="Instâncias do letreiro" Foreground="#e8e8ee"
                       FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
            <DataGrid x:Name="Grid" MouseDoubleClick="OnEdit">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Computador" Binding="{Binding HostName}" Width="1.4*" />
                    <DataGridTextColumn Header="Usuário Windows" Binding="{Binding WindowsUser}" Width="1.6*" />
                    <DataGridTextColumn Header="Versão" Binding="{Binding Version}" Width="0.7*" />
                    <DataGridTextColumn Header="Ponto" Binding="{Binding Ponto}" Width="0.7*" />
                    <DataGridTextColumn Header="Estado" Binding="{Binding StatusLabel}" Width="0.8*" />
                    <DataGridTextColumn Header="Visto" Binding="{Binding LastSeenLabel}" Width="1.2*" />
                    <DataGridTextColumn Header="Config" Binding="{Binding ConfigLabel}" Width="0.7*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</Window>
