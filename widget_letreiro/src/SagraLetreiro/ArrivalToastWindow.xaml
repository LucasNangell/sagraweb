<Window x:Class="SagraLetreiro.ArrivalToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        Title="Nova OS"
        Width="358"
        Height="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <Canvas x:Name="Stage" ClipToBounds="False">
        <Border x:Name="CardBorder"
                CornerRadius="16"
                ClipToBounds="True"
                RenderTransformOrigin="0.5,0.5">
            <Border.Clip>
                <RectangleGeometry x:Name="CardClip" po:Freeze="False" />
            </Border.Clip>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                    <SkewTransform x:Name="CardSkew" />
                    <RotateTransform x:Name="CardRotate" />
                    <TranslateTransform x:Name="CardMove" />
                </TransformGroup>
            </Border.RenderTransform>
            <Grid>
                <Border x:Name="Fill" CornerRadius="16" />
                <Border x:Name="Accent"
                        Width="6"
                        HorizontalAlignment="Left"
                        CornerRadius="16,0,0,16" />
                <StackPanel x:Name="TextStack" VerticalAlignment="Center" Margin="18,0,14,0">
                    <TextBlock x:Name="LabelText"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="TitleMove" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="SituacaoText"
                               Margin="0,4,0,0"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="SubMove" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </StackPanel>
                <Rectangle x:Name="LaserBeam"
                           Width="4"
                           HorizontalAlignment="Left"
                           Opacity="0"
                           Fill="#FFFFFFFF"
                           IsHitTestVisible="False">
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="LaserMove" />
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Border x:Name="WhiteFlash"
                        Background="White"
                        Opacity="0"
                        IsHitTestVisible="False"
                        CornerRadius="16" />
            </Grid>
        </Border>
    </Canvas>
</Window>
