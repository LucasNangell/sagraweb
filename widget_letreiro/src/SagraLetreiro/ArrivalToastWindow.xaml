<Window x:Class="SagraLetreiro.ArrivalToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        Title="Nova OS"
        Width="448"
        Height="268"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <Canvas x:Name="Stage" ClipToBounds="False">
        <Border x:Name="CardBorder"
                Opacity="0"
                CornerRadius="16"
                ClipToBounds="True"
                RenderTransformOrigin="0.5,0.5">
            <Border.Clip>
                <RectangleGeometry x:Name="CardClip" po:Freeze="False" />
            </Border.Clip>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" ScaleX="0.15" ScaleY="0.15" />
                    <TranslateTransform x:Name="CardMove" Y="-60" />
                </TransformGroup>
            </Border.RenderTransform>
            <Grid>
                <Border x:Name="Fill" CornerRadius="16" />
                <Border x:Name="Accent"
                        Width="6"
                        HorizontalAlignment="Left"
                        CornerRadius="16,0,0,16" />
                <StackPanel VerticalAlignment="Center" Margin="18,0,14,0">
                    <TextBlock x:Name="LabelText"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SituacaoText"
                               Margin="0,4,0,0"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>
    </Canvas>
</Window>
