<Window x:Class="SagraLetreiro.ArrivalToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova OS"
        Width="320"
        Height="196"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <Storyboard x:Key="Mercury">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.15" />
                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.56" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <DiscreteDoubleKeyFrame KeyTime="0:0:3" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:4" Value="0.15">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase EasingMode="EaseIn" Amplitude="0.56" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.15" />
                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.56" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <DiscreteDoubleKeyFrame KeyTime="0:0:3" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:4" Value="0.15">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase EasingMode="EaseIn" Amplitude="0.56" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CardMove" Storyboard.TargetProperty="Y">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-60" />
                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.56" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <DiscreteDoubleKeyFrame KeyTime="0:0:3" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:4" Value="40">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase EasingMode="EaseIn" Amplitude="0.56" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.56" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <DiscreteDoubleKeyFrame KeyTime="0:0:3" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:4" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase EasingMode="EaseIn" Amplitude="0.56" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CardClip" Storyboard.TargetProperty="RadiusX">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="48" />
                <LinearDoubleKeyFrame KeyTime="0:0:1" Value="16" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:3" Value="16" />
                <LinearDoubleKeyFrame KeyTime="0:0:4" Value="48" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CardClip" Storyboard.TargetProperty="RadiusY">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="48" />
                <LinearDoubleKeyFrame KeyTime="0:0:1" Value="16" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:3" Value="16" />
                <LinearDoubleKeyFrame KeyTime="0:0:4" Value="48" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>
    <Canvas>
        <Border x:Name="CardBorder"
                Canvas.Top="60"
                Width="320"
                Height="96"
                Opacity="0"
                CornerRadius="16"
                ClipToBounds="True"
                RenderTransformOrigin="0.5,0.5">
            <Border.Clip>
                <RectangleGeometry x:Name="CardClip" RadiusX="48" RadiusY="48" Rect="0,0,320,96" />
            </Border.Clip>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" ScaleX="0.15" ScaleY="0.15" />
                    <TranslateTransform x:Name="CardMove" Y="-60" />
                </TransformGroup>
            </Border.RenderTransform>
            <Grid>
                <Border x:Name="Fill" CornerRadius="16" />
                <Border x:Name="Accent"
                        Width="6"
                        HorizontalAlignment="Left"
                        CornerRadius="16,0,0,16" />
                <StackPanel VerticalAlignment="Center" Margin="18,0,14,0">
                    <TextBlock x:Name="LabelText"
                               FontWeight="Bold"
                               FontSize="22"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SituacaoText"
                               FontSize="14"
                               Margin="0,4,0,0"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>
    </Canvas>
</Window>
