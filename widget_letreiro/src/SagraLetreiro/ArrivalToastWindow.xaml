<Window x:Class="SagraLetreiro.ArrivalToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Nova OS"
        Width="358"
        Height="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <Canvas x:Name="Stage" ClipToBounds="False">
        <Ellipse x:Name="UfoLanding"
                 Height="18"
                 Opacity="0"
                 Visibility="Collapsed"
                 IsHitTestVisible="False"
                 Canvas.ZIndex="0"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#8C00FFCC" Offset="0" />
                    <GradientStop Color="#3310B981" Offset="0.5" />
                    <GradientStop Color="#00000000" Offset="0.75" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="UfoLandingScale" ScaleX="0.2" ScaleY="0.2" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <Polygon x:Name="UfoBeam"
                 Opacity="0"
                 Visibility="Collapsed"
                 IsHitTestVisible="False"
                 Canvas.ZIndex="1"
                 RenderTransformOrigin="0.5,0">
            <Polygon.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#BF00FFCC" Offset="0" />
                    <GradientStop Color="#5210B981" Offset="0.45" />
                    <GradientStop Color="#1E38BDF8" Offset="0.85" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Polygon.Fill>
            <Polygon.RenderTransform>
                <ScaleTransform x:Name="UfoBeamScale" ScaleX="0.2" ScaleY="0" />
            </Polygon.RenderTransform>
        </Polygon>
        <Border x:Name="CardBorder"
                CornerRadius="16"
                ClipToBounds="True"
                Canvas.ZIndex="2"
                RenderTransformOrigin="0.5,0.5">
            <Border.Clip>
                <RectangleGeometry x:Name="CardClip" po:Freeze="False" />
            </Border.Clip>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                    <SkewTransform x:Name="CardSkew" />
                    <RotateTransform x:Name="CardRotate" />
                    <TranslateTransform x:Name="CardMove" />
                </TransformGroup>
            </Border.RenderTransform>
            <Grid>
                <wv2:WebView2CompositionControl x:Name="CardWeb"
                                                Visibility="Collapsed"
                                                DefaultBackgroundColor="Transparent"
                                                IsHitTestVisible="False" />
                <Border x:Name="Fill" CornerRadius="16" />
                <Border x:Name="Accent"
                        Width="6"
                        HorizontalAlignment="Left"
                        CornerRadius="16,0,0,16" />
                <StackPanel x:Name="TextStack" VerticalAlignment="Center" Margin="18,0,14,0">
                    <TextBlock x:Name="LabelText"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="TitleMove" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="SituacaoText"
                               Margin="0,4,0,0"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="SubMove" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </StackPanel>
                <Rectangle x:Name="LaserBeam"
                           Width="4"
                           HorizontalAlignment="Left"
                           Opacity="0"
                           Fill="#FFFFFFFF"
                           IsHitTestVisible="False">
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="LaserMove" />
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Border x:Name="WhiteFlash"
                        Background="White"
                        Opacity="0"
                        IsHitTestVisible="False"
                        CornerRadius="16" />
            </Grid>
        </Border>
        <Canvas x:Name="UfoRig"
                Width="120"
                Height="48"
                Opacity="0"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Canvas.ZIndex="5"
                RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="UfoScale" ScaleX="1" ScaleY="1" />
                    <RotateTransform x:Name="UfoRotate" />
                    <TranslateTransform x:Name="UfoMove" />
                </TransformGroup>
            </Canvas.RenderTransform>
            <Ellipse Width="54" Height="24" Canvas.Left="33" Canvas.Top="1">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.35,0.3">
                        <GradientStop Color="#A7F3D0" Offset="0" />
                        <GradientStop Color="#10B981" Offset="0.45" />
                        <GradientStop Color="#064E3B" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="42" Height="12" Canvas.Left="39" Canvas.Top="32">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFCC" Offset="0.6" />
                        <GradientStop Color="#0284C7" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="120" Height="22" Canvas.Left="0" Canvas.Top="16">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#E2E8F0" Offset="0" />
                        <GradientStop Color="#64748B" Offset="0.45" />
                        <GradientStop Color="#1E293B" Offset="0.85" />
                        <GradientStop Color="#0F172A" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="7" Height="7" Canvas.Left="16" Canvas.Top="23" Fill="#00FFCC" />
            <Ellipse Width="7" Height="7" Canvas.Left="36" Canvas.Top="23" Fill="#38BDF8" />
            <Ellipse Width="7" Height="7" Canvas.Left="56" Canvas.Top="23" Fill="#F43F5E" />
            <Ellipse Width="7" Height="7" Canvas.Left="76" Canvas.Top="23" Fill="#EAB308" />
            <Ellipse Width="7" Height="7" Canvas.Left="96" Canvas.Top="23" Fill="#A855F7" />
        </Canvas>
        <Border x:Name="ProsseguirStreamHost"
                Opacity="0"
                Visibility="Collapsed"
                ClipToBounds="True"
                CornerRadius="10"
                IsHitTestVisible="False"
                Canvas.ZIndex="3">
            <Rectangle x:Name="ProsseguirStream" Width="960" Height="280" HorizontalAlignment="Left">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.55">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#2210B981" Offset="0.08" />
                        <GradientStop Color="#2838BDF8" Offset="0.14" />
                        <GradientStop Color="#00000000" Offset="0.22" />
                        <GradientStop Color="#2210B981" Offset="0.36" />
                        <GradientStop Color="#2838BDF8" Offset="0.42" />
                        <GradientStop Color="#00000000" Offset="0.5" />
                        <GradientStop Color="#2210B981" Offset="0.64" />
                        <GradientStop Color="#2838BDF8" Offset="0.7" />
                        <GradientStop Color="#00000000" Offset="0.78" />
                        <GradientStop Color="#2210B981" Offset="0.9" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="ProsseguirStreamMove" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Border>
        <Canvas x:Name="MagnifierRig"
                Width="80"
                Height="80"
                Opacity="0"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Canvas.ZIndex="6"
                RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="MagnifierScale" ScaleX="1.4" ScaleY="1.4" />
                    <RotateTransform x:Name="MagnifierRotate" Angle="-35" />
                    <TranslateTransform x:Name="MagnifierMove" />
                </TransformGroup>
            </Canvas.RenderTransform>
            <Ellipse Width="72" Height="72" Canvas.Left="4" Canvas.Top="0" Stroke="#E2E8F0" StrokeThickness="4">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.3,0.3" Center="0.35,0.35">
                        <GradientStop Color="#52FFFFFF" Offset="0" />
                        <GradientStop Color="#2438BDF8" Offset="0.45" />
                        <GradientStop Color="#1000FFCC" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <DropShadowEffect Color="#38BDF8" BlurRadius="18" ShadowDepth="0" Opacity="0.7"
                                      RenderingBias="Performance" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="28" Height="12" Canvas.Left="14" Canvas.Top="10" Fill="#C0FFFFFF"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="-28" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <TextBlock Canvas.Left="34" Canvas.Top="24" FontFamily="Consolas" FontSize="16"
                       Foreground="#A600FFCC" Text="+" />
            <Border Width="12" Height="36" Canvas.Left="58" Canvas.Top="58" CornerRadius="4,4,8,8"
                    BorderBrush="#334155" BorderThickness="1" RenderTransformOrigin="0.5,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#94A3B8" Offset="0" />
                        <GradientStop Color="#F8FAFC" Offset="0.45" />
                        <GradientStop Color="#475569" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                    <RotateTransform Angle="-42" />
                </Border.RenderTransform>
            </Border>
        </Canvas>
        <Border x:Name="ActionBadgeHost"
                Opacity="0"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Canvas.ZIndex="7">
            <Border x:Name="ActionBadge"
                    HorizontalAlignment="Center"
                    CornerRadius="999"
                    BorderThickness="1.5"
                    Padding="16,5"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ActionBadgeScale" ScaleX="0.4" ScaleY="0.4" />
                        <TranslateTransform x:Name="ActionBadgeMove" />
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect x:Name="ActionBadgeGlow" Color="#38BDF8" BlurRadius="16" ShadowDepth="0"
                                      Opacity="0.75" RenderingBias="Performance" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ActionBadgeDot"
                             Width="8"
                             Height="8"
                             Margin="0,0,7,0"
                             Fill="#05101F"
                             RenderTransformOrigin="0.5,0.5"
                             VerticalAlignment="Center">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="ActionBadgeDotScale" ScaleX="0.8" ScaleY="0.8" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock x:Name="ActionBadgeText"
                               FontFamily="Segoe UI"
                               FontWeight="ExtraBold"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <StackPanel x:Name="ActionChevrons"
                                Margin="8,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock x:Name="Chevron1" FontWeight="Black" FontSize="16" Margin="0,0,-4,0" Text="›"
                                   Opacity="0.3">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="Chevron1Move" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="Chevron2" FontWeight="Black" FontSize="16" Margin="0,0,-4,0" Text="›"
                                   Opacity="0.3">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="Chevron2Move" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="Chevron3" FontWeight="Black" FontSize="16" Text="›" Opacity="0.3">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="Chevron3Move" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Canvas>
</Window>
