<Window x:Class="SagraLetreiro.OsBalloonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalhes da OS"
        Width="440"
        SizeToContent="Height"
        MinHeight="280"
        MaxHeight="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        KeyDown="OnKeyDown">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#121214" />
            <Setter Property="Foreground" Value="#e8e8ee" />
            <Setter Property="BorderBrush" Value="#2e2e36" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
    </Window.Resources>
    <Border Background="#1c1c21"
            BorderBrush="#3a3a44"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
        <DockPanel>
            <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,10,0,0">
                <TextBlock x:Name="FolderError"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Foreground="#ff6961"
                           FontSize="11"
                           TextWrapping="Wrap"
                           MaxWidth="240"
                           Margin="0,0,8,0" />
                <Button x:Name="OpenFolderButton"
                        DockPanel.Dock="Right"
                        Content="Abrir pasta"
                        Padding="14,7"
                        Background="#8257e6"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnOpenFolder" />
            </DockPanel>
            <TextBlock x:Name="StatusText"
                       DockPanel.Dock="Top"
                       Foreground="#9b9ba8"
                       FontSize="12"
                       Margin="0,0,0,8"
                       Visibility="Collapsed" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="OsTitle"
                               Foreground="#e8e8ee"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Solicitante" Foreground="#9b9ba8" FontSize="11" />
                        <TextBlock x:Name="SolicitanteValue" Grid.Column="1" Foreground="#e8e8ee" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Text="Produto" Foreground="#9b9ba8" FontSize="11" Margin="0,4,0,0" />
                        <TextBlock x:Name="ProdutoValue" Grid.Row="1" Grid.Column="1" Foreground="#e8e8ee" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="2" Text="Título" Foreground="#9b9ba8" FontSize="11" Margin="0,4,0,0" />
                        <TextBlock x:Name="TituloValue" Grid.Row="2" Grid.Column="1" Foreground="#e8e8ee" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </Grid>
                    <Grid x:Name="DetailsGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="56" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Máquina" Foreground="#9b9ba8" FontSize="10" />
                            <TextBox x:Name="MaquinaBox" IsReadOnly="True" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Tiragem" Foreground="#9b9ba8" FontSize="10" />
                            <TextBox x:Name="TiragemBox" IsReadOnly="True" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="6,0,0,0">
                            <TextBlock Text="Páginas" Foreground="#9b9ba8" FontSize="10" />
                            <TextBox x:Name="PagsBox" IsReadOnly="True" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="6,0,0,0">
                            <TextBlock Text="Modelos" Foreground="#9b9ba8" FontSize="10" />
                            <TextBox x:Name="ModelosBox" IsReadOnly="True" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
                            <CheckBox x:Name="FrenteVersoBox" IsEnabled="False" VerticalAlignment="Center" />
                            <TextBlock Text="Frente/Verso" Foreground="#9b9ba8" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,8,6,0">
                            <TextBlock Text="Formato" Foreground="#9b9ba8" FontSize="10" />
                            <TextBox x:Name="FormatoBox" IsReadOnly="True" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="6,8,0,0">
                            <TextBlock Text="Prioridade" Foreground="#9b9ba8" FontSize="10" />
                            <TextBox x:Name="PrioridadeBox" IsReadOnly="True" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,6,0">
                            <TextBlock Text="Data de entrega" Foreground="#9b9ba8" FontSize="10" />
                            <TextBox x:Name="DataBox" IsReadOnly="True" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Margin="6,8,0,0">
                            <TextBlock Text="Turno" Foreground="#9b9ba8" FontSize="10" />
                            <TextBox x:Name="TurnoBox" IsReadOnly="True" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="4" Margin="0,8,0,0">
                            <TextBlock Text="Contato" Foreground="#9b9ba8" FontSize="10" />
                            <TextBox x:Name="ContatoBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="48" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                        <Grid Grid.Row="5" Grid.ColumnSpan="4" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition MinHeight="48" />
                                <RowDefinition MinHeight="48" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,4,4">
                                <TextBlock Text="Papel" Foreground="#9b9ba8" FontSize="10" />
                                <TextBox x:Name="PapelBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="44" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,4">
                                <TextBlock Text="Cores" Foreground="#9b9ba8" FontSize="10" />
                                <TextBox x:Name="CoresBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="44" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,0,4,0">
                                <TextBlock Text="Acabamento" Foreground="#9b9ba8" FontSize="10" />
                                <TextBox x:Name="AcabamentoBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="44" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Obs" Foreground="#9b9ba8" FontSize="10" />
                                <TextBox x:Name="ObsBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="44" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
