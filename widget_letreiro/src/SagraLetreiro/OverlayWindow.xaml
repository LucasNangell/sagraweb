<Window x:Class="SagraLetreiro.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAGRA Letreiro"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Width="720"
        Height="48">
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
        </Grid.ColumnDefinitions>
        <Canvas x:Name="Ticker" Grid.Column="0" ClipToBounds="True" />
        <Grid x:Name="StatusHost" Grid.Column="1" Background="Transparent">
            <Ellipse x:Name="Lamp"
                     Width="6"
                     Height="6"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Fill="#ff6961"
                     IsHitTestVisible="False" />
        </Grid>
    </Grid>
</Window>
