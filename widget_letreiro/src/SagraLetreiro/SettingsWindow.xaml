<Window x:Class="SagraLetreiro.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações do letreiro"
        Width="720"
        Height="780"
        MinWidth="580"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#0f0f12"
        Foreground="#e8e8ee"
        FontFamily="Segoe UI"
        Topmost="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Card" Color="#1c1c21" />
        <SolidColorBrush x:Key="Input" Color="#121214" />
        <SolidColorBrush x:Key="Border" Color="#2e2e36" />
        <SolidColorBrush x:Key="Muted" Color="#9b9ba8" />
        <SolidColorBrush x:Key="Accent" Color="#8257e6" />
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Input}" />
            <Setter Property="Foreground" Value="#e8e8ee" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource Input}" />
            <Setter Property="Foreground" Value="#e8e8ee" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#e8e8ee" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#e8e8ee" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Background" Value="#2a2a32" />
            <Setter Property="Foreground" Value="#e8e8ee" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="16" Background="#16161a">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Restaurar grupos" Click="OnRestore" />
                <Button Content="Cancelar" Click="OnCancel" />
                <Button Content="Salvar" Click="OnSave" Background="#8257e6" Foreground="White" />
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>
                <Border Background="{StaticResource Card}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Title}" Text="Conexão" />
                        <TextBlock Text="API" />
                        <TextBox x:Name="ApiBox" />
                        <TextBlock Text="Produção: https://cgrafsysvm.redecamara.camara.gov.br/sagra/api"
                                   FontSize="10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Ponto" />
                                <TextBox x:Name="PontoBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Nome" />
                                <TextBox x:Name="NomeBox" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Senha (se o IP exigir)" />
                                <PasswordBox x:Name="PasswordBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="8,0,0,10">
                                <CheckBox x:Name="SslBox" Content="Verificar certificado SSL" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Card}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Title}" Text="Painel" />
                        <TextBlock Text="Setor monitorado" />
                        <ComboBox x:Name="SectorBox" IsEditable="True" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Card}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource Title}" Text="Grupos" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="+ grupo" Click="OnAddGroup" />
                        </DockPanel>
                        <StackPanel x:Name="GroupsHost" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Card}" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Title}" Text="Letreiro" />
                        <DockPanel>
                            <TextBlock Text="Velocidade do deslize" />
                            <TextBlock x:Name="SpeedLabel" DockPanel.Dock="Right" Foreground="#e8e8ee" FontWeight="SemiBold" />
                        </DockPanel>
                        <Slider x:Name="SpeedSlider" Minimum="8" Maximum="160" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="OnSpeedChanged" Margin="0,4,0,10" />
                        <DockPanel>
                            <TextBlock Text="Opacidade" />
                            <TextBlock x:Name="OpacityLabel" DockPanel.Dock="Right" Foreground="#e8e8ee" FontWeight="SemiBold" />
                        </DockPanel>
                        <Slider x:Name="OpacitySlider" Minimum="0.4" Maximum="1" TickFrequency="0.01"
                                ValueChanged="OnOpacityChanged" Margin="0,4,0,10" />
                        <CheckBox x:Name="TransparentBox" Content="Fundo transparente (mostra a barra de tarefas atrás)" />
                        <TextBlock Text="Exibir na faixa" Margin="0,12,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <CheckBox x:Name="ShowOsBox" Content="OS (nº &lt; 5000)" Margin="0,6,16,0" />
                            <CheckBox x:Name="ShowSpBox" Content="SP (nº ≥ 5000)" />
                        </StackPanel>
                        <TextBlock Text="O deslize só ocorre quando os cards não cabem. As OSs entram pela direita."
                                   Margin="0,8,0,0" FontSize="10" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
